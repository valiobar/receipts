# ============================================
# Server Configuration
# ============================================

# Environment mode: development, production, or test
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# ============================================
# Database Configuration
# ============================================

# MongoDB connection string
# Format: mongodb://[username:password@]host[:port][/database][?options]
# Example: mongodb://localhost:27017/receipt
# Example with auth: mongodb://user:pass@localhost:27017/receipt?authSource=admin
MONGODB_URI=mongodb://localhost:27017/receipt

# ============================================
# Authentication Configuration
# ============================================

# JWT secret key for signing tokens
# Generate a strong random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production

# JWT token expiration time
# Format: number + unit (s, m, h, d)
# Examples: 24h, 7d, 3600s
JWT_EXPIRES_IN=24h

# ============================================
# Webhook Configuration
# ============================================

# Comma-separated list of IP addresses allowed to send webhooks
# Leave empty to disable IP whitelist (not recommended for production)
# Example: 213.91.159.250,87.121.163.64
WEBHOOK_IPS=213.91.159.250,87.121.163.64

# ============================================
# BRP Event API Configuration (Optional)
# ============================================
# These variables are required only if you want to automatically register
# webhooks with the BRP Event API on server startup.

# BRP Event API base URL
# This is the base URL of your BRP Event API instance
# Contact your BRP administrator or check BRP documentation for the correct URL
# Example: https://api.brp.example.com
# Example: https://events.brp-system.com
# How to get it:
#   - Contact your BRP system administrator
#   - Check BRP system documentation
#   - Look in BRP admin panel under API settings
BRP_API_URL=

# BRP Event API authentication key (optional)
# Some BRP installations require API key authentication
# This is typically a Bearer token or API key
# How to get it:
#   - Contact your BRP system administrator
#   - Generate in BRP admin panel under API settings
#   - Check BRP API documentation for authentication requirements
#   - If not required, leave empty
BRP_API_KEY=

# Public webhook URL where BRP will send event notifications
# This must be publicly accessible (not localhost)
# Format: https://your-domain.com/webhook
# Example: https://api.yourcompany.com/webhook
# Example: https://receipts.yourcompany.com/webhook
# How to set it up:
#   1. Deploy your server to a public domain
#   2. Ensure the /webhook endpoint is accessible via HTTPS
#   3. Use this full URL (including /webhook path)
#   4. For development/testing, use a service like ngrok:
#      - Install ngrok: https://ngrok.com/
#      - Run: ngrok http 3000
#      - Use the HTTPS URL provided: https://xxxx.ngrok.io/webhook
BRP_WEBHOOK_URL=

# Webhook secret for authenticating incoming webhook requests (optional)
# This secret will be sent with webhook registrations
# BRP may use this to sign webhook payloads for verification
# Generate a strong random string
# Example: openssl rand -base64 32
# How to get it:
#   - Generate your own secret (recommended)
#   - Or check if BRP requires a specific format
#   - If not required, leave empty
BRP_WEBHOOK_SECRET=

# ============================================
# Notes
# ============================================
# 
# 1. Copy this file to .env in the server directory
# 2. Fill in all required values (marked as required above)
# 3. BRP configuration is optional - webhook registration will be skipped if not provided
# 4. Never commit .env file to version control
# 5. For production, use secure values and enable HTTPS


