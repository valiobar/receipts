{
    "name": "receipts-server",
    "version": "1.0.0",
    "description": "Backend server for receipts management system",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "express": "^4.18.2",
        "socket.io": "^4.6.1",
        "mongoose": "^7.5.0",
        "jsonwebtoken": "^9.0.2",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.3.1",
        "winston": "^3.11.0",
        "winston-daily-rotate-file": "^4.7.1",
        "cors": "^2.8.5",
        "express-validator": "^7.0.1",
        "exceljs": "^4.4.0"
    },
    "devDependencies": {
        "typescript": "^5.2.2",
        "@types/node": "^20.8.7",
        "@types/express": "^4.17.20",
        "@types/jsonwebtoken": "^9.0.4",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.15",
        "ts-node-dev": "^2.0.0"
    }
}